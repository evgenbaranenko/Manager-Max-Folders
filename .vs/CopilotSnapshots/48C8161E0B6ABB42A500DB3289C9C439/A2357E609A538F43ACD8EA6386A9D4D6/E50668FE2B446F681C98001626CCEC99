        private bool Create3dsMaxStructureFolders(string basePath, BatchOperationLog? log = null)
        {
            bool createdSomething = false;

            string mainFolder = Path.Combine(basePath, "03_3dsMax");
            createdSomething |= SafeCreate(mainFolder, log);

            string[] subFolders =
            {
                "00_Temp",
                "01_Max",
                "02_Texture",
                "03_Render",
                "04_Import",
                "05_Export",
                "06_Proxy",
                "07_Models"
            };

            foreach (var sub in subFolders)
            {
                createdSomething |= SafeCreate(Path.Combine(mainFolder, sub), log);
            }

            createdSomething |= SafeCreate(Path.Combine(basePath, "02_IN"), log);
            createdSomething |= SafeCreate(Path.Combine(basePath, "04_OUT"), log);
            createdSomething |= SafeCreate(Path.Combine(basePath, "01_Contract"), log);

            return createdSomething;
        }

