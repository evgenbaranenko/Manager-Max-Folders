        private bool TryResolveDestination(string sourcePath, out string destinationPath)
        {
            destinationPath = null;

            if (!string.IsNullOrWhiteSpace(textBoxDestinationPath.Text))
            {
                destinationPath = textBoxDestinationPath.Text.Trim();

                if (!Directory.Exists(destinationPath))
                {
                    MessageBox.Show(MessageText.PathDestinationNotExist);
                    return false;
                }

                return true;
            }

            destinationPath = Directory.GetParent(sourcePath)?.FullName;
            if (destinationPath == null)
            {
                MessageBox.Show(MessageText.UnableToDetermineParentFolder);
                return false;
            }

            return true;
        }

